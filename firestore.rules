rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only YOUR account counts as the owner.
    // Replace PASTE_OWNER_UID_HERE with your User UID
    // (Firebase console > Authentication > Users > "User UID" column).
    function isOwner() {
      return request.auth != null && request.auth.uid == 'PASTE_OWNER_UID_HERE';
    }

    function validStr(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Guestbook notes
    match /messages/{messageId} {
      // Visitors can read public notes only. You can read everything.
      allow read: if isOwner() || resource.data.isPublic == true;

      // Anyone can leave a note, but only in this exact shape and size.
      allow create: if request.resource.data.keys().hasOnly(['author', 'text', 'isPublic', 'read', 'createdAt'])
                    && request.resource.data.keys().hasAll(['author', 'text', 'isPublic', 'read', 'createdAt'])
                    && validStr(request.resource.data.author, 40)
                    && validStr(request.resource.data.text, 500)
                    && request.resource.data.isPublic is bool
                    && request.resource.data.read == false
                    && request.resource.data.createdAt == request.time;

      // Only you can change visibility, mark as read, or delete.
      allow update, delete: if isOwner();
    }

    // Link click analytics
    match /clicks/{clickId} {
      // Anyone's click can be logged, but nobody except you can read the log.
      allow create: if request.resource.data.keys().hasOnly(['linkId', 'linkTitle', 'handle', 'visitorId', 'referrer', 'device', 'createdAt'])
                    && request.resource.data.keys().hasAll(['linkId', 'linkTitle', 'handle', 'visitorId', 'referrer', 'device', 'createdAt'])
                    && validStr(request.resource.data.linkId, 40)
                    && validStr(request.resource.data.linkTitle, 100)
                    && (request.resource.data.handle == null || validStr(request.resource.data.handle, 40))
                    && validStr(request.resource.data.visitorId, 60)
                    && validStr(request.resource.data.referrer, 100)
                    && validStr(request.resource.data.device, 100)
                    && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isOwner();
    }
  }
}
